#!/usr/bin/env bash
#
# install-to-bin
# Create symlinks in ~/bin for the most useful IndianaDell scripts so they
# are always available in $PATH without typing the full path.
#
# This is a convenience installer. The primary mechanism remains
# ~/.config/indianadell/path.sh (which puts the bin/ directory first).
#
# Usage:
#   bin/install-to-bin
#   bin/install-to-bin --force          # overwrite existing links
#   bin/install-to-bin --list           # show what would be linked
#
set -euo pipefail

FORCE=0
LIST_ONLY=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --force) FORCE=1; shift ;;
    --list)  LIST_ONLY=1; shift ;;
    -h|--help)
      sed -n '4,16p' "$0"
      exit 0
      ;;
    *) echo "Unknown argument: $1"; exit 1 ;;
  esac
done

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BIN_DIR="${HOME}/bin"
mkdir -p "$BIN_DIR"

# Discover every executable script under bin/ and scripts/**/
discover_scripts() {
  local -a found=()

  # bin/ (already the primary place)
  while IFS= read -r -d '' f; do
    found+=("$f")
  done < <(find "$ROOT/bin" -maxdepth 1 -type f -executable -print0 2>/dev/null)

  # All scripts/ subdirectories
  while IFS= read -r -d '' f; do
    found+=("$f")
  done < <(find "$ROOT/scripts" -type f -executable -name '*.sh' -print0 2>/dev/null)

  # Also pick up Python scripts that have a shebang (so they are runnable)
  while IFS= read -r -d '' f; do
    if head -c 80 "$f" | grep -q '^#!.*python'; then
      found+=("$f")
    fi
  done < <(find "$ROOT/scripts" -type f -name '*.py' -print0 2>/dev/null)

  printf '%s\n' "${found[@]}"
}

link_one() {
  local full_src="$1"
  local name
  name="$(basename "$full_src")"

  # Strip common extensions for nicer command names
  name="${name%.sh}"
  name="${name%.py}"

  local target="$BIN_DIR/$name"

  # Ensure the source is executable
  if [[ ! -x "$full_src" ]]; then
    chmod +x "$full_src"
    echo "CHMOD +x $(realpath --relative-to="$ROOT" "$full_src")"
  fi

  if [[ -L "$target" || -e "$target" ]]; then
    if [[ $FORCE -eq 1 ]]; then
      rm -f "$target"
    else
      local current
      current="$(readlink "$target" 2>/dev/null || echo "$target")"
      if [[ "$current" != "$full_src" ]]; then
        echo "EXISTS (different) $name -> $current"
      fi
      return 0
    fi
  fi

  if [[ $LIST_ONLY -eq 1 ]]; then
    echo "LINK  $name -> $full_src"
    return 0
  fi

  ln -s "$full_src" "$target"
  echo "INSTALLED $name -> $full_src"
}

echo "=== Installing ALL IndianaDell scripts to $BIN_DIR ==="

mapfile -t scripts < <(discover_scripts | sort -u)

for s in "${scripts[@]}"; do
  [[ -n "$s" ]] || continue
  link_one "$s"
done

if [[ $LIST_ONLY -eq 0 ]]; then
  echo
  echo "Done. $((${#scripts[@]})) scripts now available in $BIN_DIR"
  echo "Make sure $BIN_DIR is in your PATH (it is via ~/.config/indianadell/path.sh)."
fi